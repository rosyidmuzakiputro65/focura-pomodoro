rules_version = '2';

// Aturan keamanan Cloud Firestore untuk Focura.
// Salin isi file ini ke Firebase Console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Validasi data tugas di server (sama dengan validasi di aplikasi).
    function validTask(d) {
      return d.keys().hasOnly(['title', 'description', 'estimatedPomodoros',
                               'completedPomodoros', 'priority', 'isDone',
                               'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 80
        && d.description is string && d.description.size() <= 300
        && d.estimatedPomodoros is int
        && d.estimatedPomodoros >= 1 && d.estimatedPomodoros <= 10
        && d.completedPomodoros is int && d.completedPomodoros >= 0
        && d.priority in ['low', 'medium', 'high']
        && d.isDone is bool
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    function validSession(d) {
      return d.keys().hasOnly(['minutes', 'completedAt', 'taskTitle'])
        && d.minutes is int && d.minutes >= 1 && d.minutes <= 180
        && d.completedAt is timestamp;
    }

    // Setiap pengguna hanya bisa membaca & menulis datanya sendiri.
    match /users/{uid} {
      allow read: if signedIn(uid);
      allow create, update: if signedIn(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 50;

      match /tasks/{taskId} {
        allow read, delete: if signedIn(uid);
        allow create, update: if signedIn(uid) && validTask(request.resource.data);
      }

      match /sessions/{sessionId} {
        allow read: if signedIn(uid);
        allow create: if signedIn(uid) && validSession(request.resource.data);
      }
    }
  }
}
